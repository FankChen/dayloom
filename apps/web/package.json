{
  "name": "@dayloom/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/localization.unit.mjs",
    "format": "prettier --write src tests *.ts *.json index.html",
